# --- Папки виртуальных окружений (не нужны в коде, создаются при запуске) ---
venv/
env/
.venv/
ENV/

# --- Файлы окружения (пароли, токены) ---
.env
.env.local
.env.*

# --- Кэш Python (генерируется автоматически при запуске) ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg

# --- Настройки IDE и редакторов (личное дело каждого) ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Логирование ---
*.log
logs/
